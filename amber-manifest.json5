{
  manifest_version: "0.1.0",

  // API keys and provider config for the CRM agent's LLM client.
  // Two independent tiers — primary (expensive) and cheap — each backed by
  // any OpenAI-compatible provider via a key + optional base URL override.
  config_schema: {
    type: "object",
    properties: {
      // ── Primary tier ──────────────────────────────────────────────────
      openai_api_key:       { type: "string", secret: true },   // OPENAI_API_KEY
      llm_primary_base_url: { type: "string" },                 // LLM_PRIMARY_BASE_URL
      llm_primary_model:    { type: "string" },                 // LLM_PRIMARY_MODEL
      // ── Cheap tier ────────────────────────────────────────────────────
      openai_cheap_api_key: { type: "string", secret: true },   // OPENAI_CHEAP_API_KEY
      llm_cheap_base_url:   { type: "string" },                 // LLM_CHEAP_BASE_URL
      llm_cheap_model:      { type: "string" },                 // LLM_CHEAP_MODEL
    },
    required: ["openai_api_key"],
    additionalProperties: false,
  },

  // External services this agent uses
  slots: {
    proxy: { kind: "a2a", optional: true },
  },

  // Runtime configuration
  program: {
    image: "ghcr.io/madgaa-lab/crm-agent-phase2_dev:latest",
    entrypoint: "uv run python src/server.py --host 0.0.0.0 --port 9009",

    env: {
      OPENAI_API_KEY:       "${config.openai_api_key}",
      LLM_PRIMARY_BASE_URL: "${config.llm_primary_base_url}",
      LLM_PRIMARY_MODEL:    "${config.llm_primary_model}",
      OPENAI_CHEAP_API_KEY: "${config.openai_cheap_api_key}",
      LLM_CHEAP_BASE_URL:   "${config.llm_cheap_base_url}",
      LLM_CHEAP_MODEL:      "${config.llm_cheap_model}",
    },

    network: {
      endpoints: [
        { name: "a2a_endpoint", port: 9009 }, // ensure port matches your entrypoint
      ],
    },
  },

  // Capabilities provided by this agent
  provides: {
    a2a: { kind: "a2a", endpoint: "a2a_endpoint" },
  },

  // Capabilities exposed to the scenario
  exports: { a2a: "a2a" },
}
