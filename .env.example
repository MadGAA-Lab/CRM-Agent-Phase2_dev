# ─────────────────────────────────────────────────────────────────────────────
# CRM Purple Agent — local development environment
# Copy this file to .env and fill in your keys.
# .env is gitignored and never committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Primary LLM tier (required) ──────────────────────────────────────────────
# Any OpenAI-compatible API key.
# Examples:
#   Anthropic claude-sonnet-4-6  → sk-ant-api03-...
#   OpenAI gpt-4o                → sk-proj-...
#   Local vLLM / Ollama          → dummy
OPENAI_PRIMARY_API_KEY=sk-ant-api03-YOUR_KEY_HERE

# Base URL for the primary provider.
# Defaults to Anthropic's OpenAI-compat endpoint if not set.
# LLM_PRIMARY_BASE_URL=https://api.anthropic.com/v1
# LLM_PRIMARY_BASE_URL=https://api.openai.com/v1
# LLM_PRIMARY_BASE_URL=http://localhost:8000/v1
LLM_PRIMARY_BASE_URL=https://api.anthropic.com/v1

# Primary model name.
# LLM_PRIMARY_MODEL=claude-sonnet-4-6
# LLM_PRIMARY_MODEL=gpt-4o
LLM_PRIMARY_MODEL=claude-sonnet-4-6

# ── Cheap LLM tier (optional — falls back to primary if not set) ─────────────
# Use a faster/cheaper model for context filtering tasks.
# Uncomment to enable a separate cheap tier.
# OPENAI_CHEAP_API_KEY=sk-ant-api03-YOUR_CHEAP_KEY_HERE
# LLM_CHEAP_BASE_URL=https://api.anthropic.com/v1
# LLM_CHEAP_MODEL=claude-haiku-4-5

# ── Server (optional) ────────────────────────────────────────────────────────
# HOST=127.0.0.1
# PORT=9009
